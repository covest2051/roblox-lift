{
	"name": "SurpriseLift",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			},
			"Remotes": {
				"$className": "Folder",
				"ClientAction": {
					"$className": "RemoteEvent"
				},
				"ServerEvent": {
					"$className": "RemoteEvent"
				}
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"StarterPlayer": {
			"$properties": {
				"CameraMaxZoomDistance": 60,
				"CameraMinZoomDistance": 4,
				"CharacterWalkSpeed": 16,
				"CharacterJumpHeight": 7.2,
				"CharacterUseJumpPower": true,
				"CharacterJumpPower": 50
			},
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				}
			}
		},
		"Lighting": {
			"$properties": {
				"ClockTime": 14,
				"Brightness": 2,
				"GlobalShadows": true,
				"Ambient": [120, 115, 130],
				"OutdoorAmbient": [140, 135, 150],
				"FogColor": [190, 210, 240],
				"FogStart": 300,
				"FogEnd": 900,
				"EnvironmentDiffuseScale": 0.6,
				"EnvironmentSpecularScale": 0.6
			}
		},
		"Workspace": {
			"$properties": {
				"Gravity": 196.2,
				"StreamingEnabled": false
			}
		},
		"SoundService": {
			"$properties": {
				"RespectFilteringEnabled": true
			}
		},
		"Players": {
			"$properties": {
				"CharacterAutoLoads": false
			}
		}
	}
}
